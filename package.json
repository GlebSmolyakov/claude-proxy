{
  "name": "claude-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "An ACP agent that runs Claude Code inside an editor, through the Claude Agent SDK",
  "license": "Apache-2.0",
  "author": "Gleb Smolyakov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlebSmolyakov/claude-proxy.git"
  },
  "homepage": "https://github.com/GlebSmolyakov/claude-proxy#readme",
  "bugs": "https://github.com/GlebSmolyakov/claude-proxy/issues",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "claude",
    "claude-code",
    "editor",
    "agent"
  ],
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "bin": {
    "claude-proxy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "pnpm run build && pnpm run start",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run format:check",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.274",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.5.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
